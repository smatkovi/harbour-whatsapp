[Desktop Entry]
Type=Application
Name=WhatsApp
Icon=harbour-whatsapp
Exec=sailfish-qml harbour-whatsapp
X-Nemo-Application-Type=silica-qt5

[X-Sailjail]
Permissions=Internet;Secrets;
OrganizationName=harbour
ApplicationName=harbour-whatsapp
ExecDBus=/usr/bin/sailjail -p harbour-whatsapp.desktop -- /usr/bin/sailfish-qml harbour-whatsapp
